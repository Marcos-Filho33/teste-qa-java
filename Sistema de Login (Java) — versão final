import java.util.Scanner;

public class SistemaLogin {

    // Método para validar login (melhor prática)
    public static boolean validarLogin(String usuario, String senha) {
        String usuarioCorreto = "admin";
        String senhaCorreta = "1234";

        return usuario.equals(usuarioCorreto) && senha.equals(senhaCorreta);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("=== Sistema de Login ===");

        System.out.print("Usuário: ");
        String usuario = sc.nextLine().trim();

        System.out.print("Senha: ");
        String senha = sc.nextLine().trim();

        // Validação de campos vazios
        if (usuario.isEmpty() || senha.isEmpty()) {
            System.out.println("Erro: os campos não podem estar vazios.");
        } 
        // Validação do login
        else if (validarLogin(usuario, senha)) {
            System.out.println("Login realizado com sucesso!");
        } 
        else {
            System.out.println("Erro: usuário ou senha incorretos.");
        }

        sc.close();
    }
}
